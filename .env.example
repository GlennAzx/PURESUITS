# Base URL for media served from Cloudflare R2. No trailing slash.
#
# Copy this file to .env.local and set the value. The same variable must be set
# in the Workers build environment for the deployed site.
#
# Leave it UNSET to serve media from this origin instead (anything in public/).
# That fallback is what keeps the site running before the bucket exists.
#
# After enabling R2 and connecting a custom domain to the bucket:
#   VITE_MEDIA_BASE=https://media.puresuit.net
#
# Or use the bucket's r2.dev development URL while testing:
#   VITE_MEDIA_BASE=https://pub-<hash>.r2.dev

VITE_MEDIA_BASE=
