node_modules
dist
dist-ssr
*.local
.DS_Store

# Local tool state, not part of the site.
.omc

# Media staging. Heavy source files live in R2, never in git — git keeps every
# version of a binary forever, so one committed clip bloats every future clone.
# Upload with: node scripts/upload-media.mjs ./media/<dir> <prefix>
/media/

# Local env (holds VITE_MEDIA_BASE)
.env.local

# Local secrets. The admin token lives here and is NOT committed: the repo is
# public, and anyone holding the token can write to the live site.
/.secrets/

# Local Worker secrets for `wrangler dev`. Never committed.
.dev.vars
