{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puresuits",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-20",
  // The Worker exists only for /api/*: static hosting cannot accept a write,
  // and the admin page needs to save events without a deploy.
  //
  // run_worker_first sends /api/* to worker/index.js. Every other request goes
  // straight to the assets, so the site keeps the zero-cost static path.
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The bucket that holds content/site.json and all the media.
  "r2_buckets": [
    {
      "bucket_name": "puresuit-media",
      "binding": "MEDIA"
    }
  ]
  // ADMIN_TOKEN is a secret, not a variable here:
  //   npx wrangler secret put ADMIN_TOKEN
  // Without it the API refuses every write (it fails closed on purpose).
}
